# untrusted extracted archives and downloads
research/atlan4-extracted/
research/dpos350p/*.iso
research/dpos350p/*.zip

# hardware backups (never commit flash dumps)
backups/

# build outputs
firmware/**/build/
firmware/**/build-*/
firmware/**/dist/
firmware/**/*.o
firmware/**/*.elf
firmware/**/*.bin
fpga/**/build/
fpga/**/*.db
fpga/**/*.bit
fpga/**/*.bin
fpga/**/*.rbf
# released bitstreams are committed with their hashes (fpga/al3/dist/manifest.json, tools/bitstreams.py)
!fpga/al3/dist/*.bin

# python
mcp/.venv/
__pycache__/
*.pyc

# editors / os
.vscode/
*.swp
Thumbs.db

# FPGA bitstream images stay on disk; only the provenance README is tracked
fpga/al3/bitstreams/*
!fpga/al3/bitstreams/README.md

# personal Anlogic TD licence, never commit
fpga/al3/license/
research/tools/vendor/

# agent worktrees (local)
.claude/worktrees/

# the owner's local Claude Code MCP config (tracked example: .mcp.json.example)
.mcp.json

# mkdocs build output
/site/
