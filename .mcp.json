{
  "mcpServers": {
    "fnirsi1013d-sim": {
      "type": "stdio",
      "command": "mcp/.venv/Scripts/fnirsi1013d-mcp.exe",
      "args": ["--sim", "--variant al3 --signal decay:tau=80us,amp=0.3,period=1ms,width=200us --time-scale 1"],
      "env": {
        "FNIRSI_MCP_MAX_TIER": "3",
        "FNIRSI_MCP_DATA_DIR": "mcp/data",
        "FNIRSI_MCP_AUDIT_LOG": "mcp/logs/audit.jsonl"
      }
    }
  }
}
